# Copy to .env for local use. On a hosting platform, set these as Environment Variables instead.
NODE_ENV=production
PORT=3000

# --- Provider API (server-side only, never sent to the browser) ---
API_BASE_URL=https://api.dkwinapi.com/api/webapi
API_KEY=
API_SECRET=
# How the key is sent. Adjust to the provider's documentation.
API_KEY_HEADER=Authorization
API_KEY_PREFIX="Bearer "
# true = send an HMAC-SHA256 body signature in header X-Signature (signed with API_SECRET)
SIGN_REQUESTS=false
API_TIMEOUT_MS=15000
# Optional: map provider status values to internal ones, e.g. {"0":"PENDING","1":"COMPLETED","2":"CANCELLED"}
STATUS_MAP_JSON=

# --- App ---
# Must be a random string of 32+ characters
SESSION_SECRET=
# Where SQLite is stored. On a host, mount a persistent volume at /app/data
DATABASE_URL=./data/admin.db
SESSION_IDLE_MIN=30
SESSION_MAX_HOURS=12
POLL_INTERVAL_MS=15000
CORS_ORIGINS=
# Behind a platform proxy (Render/Railway/Coolify...) keep true. Set FORCE_HTTPS=true only if your platform sends X-Forwarded-Proto.
TRUST_PROXY=true
FORCE_HTTPS=false
# Login cookie is marked Secure (HTTPS only) in production. If you open the site over plain http:// (no HTTPS yet), set false.
COOKIE_SECURE=true

# First-run only: creates a SUPER_ADMIN if no admin exists. REMOVE ADMIN_PASSWORD after the first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
